<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.main.ejercicio1_5.PrimaryController">
   <children>
      <Label layoutX="30.0" layoutY="30.0" text="Alimentación" />
      <TextField fx:id="txtAlimentacion" layoutX="120.0" layoutY="26.0" prefWidth="130.0" />

      <Label layoutX="30.0" layoutY="70.0" text="Refrigerios" />
      <TextField fx:id="txtRefrigerios" layoutX="120.0" layoutY="66.0" prefWidth="130.0" />

      <Label layoutX="30.0" layoutY="110.0" text="Transporte" />
      <TextField fx:id="txtTransporte" layoutX="120.0" layoutY="106.0" prefWidth="130.0" />

      <Label layoutX="30.0" layoutY="150.0" text="Telefonía" />
      <TextField fx:id="txtTelefonia" layoutX="120.0" layoutY="146.0" prefWidth="130.0" />

      <Label layoutX="30.0" layoutY="190.0" text="Otros" />
      <TextField fx:id="txtOtros" layoutX="120.0" layoutY="186.0" prefWidth="130.0" />

      <Button fx:id="btnCalcular" layoutX="30.0" layoutY="250.0" onAction="#btnCalcularOnAction" prefWidth="110.0" text="Calcular" />
      <Button fx:id="btnLimpiar" layoutX="155.0" layoutY="250.0" onAction="#btnLimpiarOnAction" prefWidth="95.0" text="Limpiar" />

      <Label layoutX="310.0" layoutY="30.0" text="Estadísticas">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Label layoutX="310.0" layoutY="70.0" text="Total semanal" />
      <TextField fx:id="txtTotalSemanal" editable="false" layoutX="310.0" layoutY="95.0" prefWidth="180.0" />

      <Label layoutX="310.0" layoutY="145.0" text="Gasto más alto" />
      <TextField fx:id="txtGastoAlto" editable="false" layoutX="310.0" layoutY="170.0" prefWidth="180.0" />
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</AnchorPane>